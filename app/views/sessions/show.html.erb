<% content_for :title, "#{@session.workshop.title}, #{l(@session.starts_at, format: :short)}" %>

<nav aria-label="Fil d'Ariane">
  <ol class="breadcrumb">
    <li class="breadcrumb-item"><%= link_to "Catalogue", workshops_path %></li>
    <li class="breadcrumb-item"><%= link_to @session.workshop.title, @session.workshop %></li>
    <li class="breadcrumb-item active" aria-current="page"><%= l(@session.starts_at, format: :short) %></li>
  </ol>
</nav>

<%= turbo_frame_tag "session_details" do %>
  <div class="d-flex align-items-center gap-3 mb-3">
    <h1 class="h2 mb-0"><%= @session.workshop.title %></h1>
    <%= status_badge(@session) %>
  </div>

  <dl class="row">
    <dt class="col-sm-3">Début</dt>
    <dd class="col-sm-9"><%= l(@session.starts_at, format: :long) %></dd>

    <dt class="col-sm-3">Capacité</dt>
    <dd class="col-sm-9"><%= pluralize(@session.capacity, "place", plural: "places") %></dd>

    <dt class="col-sm-3">Places restantes</dt>
    <dd class="col-sm-9"><%= @session.remaining_seats %></dd>
  </dl>

  <%= link_to "Modifier", edit_session_path(@session), class: "btn btn-outline-secondary btn-sm" %>
  <%= link_to "Voir l'atelier", @session.workshop, class: "btn btn-link btn-sm", data: { turbo_frame: "_top" } %>
<% end %>

<h2 class="h4 mt-5 mb-3">S'inscrire</h2>
<% if @session.remaining_seats.positive? %>
  <%= render "registrations/form", session: @session %>
<% else %>
  <p class="text-muted">Plus aucune place disponible.</p>
<% end %>

<h2 class="h4 mt-5 mb-3">Inscrits</h2>
<% if @session.registrations.any? %>
  <table class="table table-sm align-middle">
    <thead>
      <tr>
        <th>Nom</th>
        <th>Email</th>
        <th>Inscrit le</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <%= render @session.registrations.order(:created_at) %>
    </tbody>
  </table>
<% else %>
  <p class="text-muted">Personne n'est encore inscrit.</p>
<% end %>

<%= render "notes/notes", notable: @session %>

<div class="mt-4">
  <%= button_to "Supprimer", @session, method: :delete, class: "btn btn-outline-danger" %>
</div>
