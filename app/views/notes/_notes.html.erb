<h2 class="h4 mt-5 mb-3">Notes internes</h2>

<% if notable.notes.any? %>
  <ul class="list-group mb-3">
    <% notable.notes.order(:created_at).each do |note| %>
      <li class="list-group-item">
        <%= note.body %>
        <small class="text-muted d-block"><%= l(note.created_at, format: :short) %></small>
      </li>
    <% end %>
  </ul>
<% else %>
  <p class="text-muted">Aucune note pour l'instant.</p>
<% end %>

<%= form_with model: [ notable, Note.new ], data: { controller: "counter" } do |form| %>
  <div class="d-flex gap-2">
    <%= form.text_field :body, placeholder: "Ajouter une note", required: true, maxlength: 200, class: "form-control",
          data: { counter_target: "input", action: "input->counter#update" } %>
    <%= form.submit "Ajouter", class: "btn btn-outline-primary" %>
  </div>
  <small class="text-muted" data-counter-target="count"></small>
<% end %>
